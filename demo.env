#auto-instrumentation

OTEL_SERVICE_NAME=Laravel-Instrumentation
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://signoz-otel-collector:4318/v1/traces #docker
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://signoz-otel-collector:4318/v1/logs
OTEL_PHP_AUTOLOAD_ENABLED=true
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_LOG_LEVEL=info
# # OTEL_LOG_LEVEL=none #to disable logs
OTEL_PROPAGATORS=baggage,tracecontext
OTEL_ENABLED=true

