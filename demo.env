APP_NAME=PHP_Integration_Signoz
APP_ENV=local
APP_KEY=base64:SpwTmUWQ0hpnp1X20FmANXo4aRNcLkTeK0/bxjnWQRo=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION=pgsql
# DB_HOST=10.104.10.140
